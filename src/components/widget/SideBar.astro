---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../../config";
import { url } from "../../utils/url-utils";
import Profile from "./Profile.astro";
import TOC from "./TOC.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const className = Astro.props.class;
const headings = Astro.props.headings ?? [];
const isPostsRoute = Astro.url.pathname.startsWith(url("/posts/"));
const hasToc = siteConfig.toc.enable && isPostsRoute && headings.length > 0;
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <div id="sidebar-profile" class="flex flex-col w-full gap-4 mb-4">
        <Profile></Profile>
    </div>
    <div id="sidebar-sticky" class="transition-all duration-700 flex flex-col w-full gap-4 sticky top-4">
        <div id="toc" class="w-full transition-swup-fade empty:hidden">{hasToc && (
            <div class="pt-4 pb-3 card-base onload-animation" style="animation-delay: 100ms">
                <div class="font-bold transition text-base text-neutral-900 dark:text-neutral-100 relative ml-7 mb-2.5
                    before:w-1 before:h-4 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:left-[-14px] before:top-[4px]">目录</div>
                <div id="toc-inner-wrapper" class="relative isolate px-3 max-h-[calc(100vh-8rem)] overflow-y-auto overflow-x-hidden toc-scrollbar">
                    <TOC headings={headings}></TOC>
                </div>
            </div>
        )}</div>
    </div>
</div>
